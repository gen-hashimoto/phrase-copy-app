          <mxGeometry height="15" width="10" x="80" y="165" as="geometry" />
        </mxCell>
        <mxCell id="Up0seM3ziYC3CZbjDRAz-624" parent="Up0seM3ziYC3CZbjDRAz-484" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.forms.searchBox;strokeColor=#999999;mainText=;strokeColor2=#008cff;fontColor=#666666;fontSize=17;align=left;spacingLeft=3;whiteSpace=wrap;" value="Search" vertex="1">
          <mxGeometry height="30" width="150" x="120" y="210" as="geometry" />
        </mxCell>
        <mxCell id="Up0seM3ziYC3CZbjDRAz-630" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ログイン後トップ画面&lt;/h1&gt;&lt;p&gt;※ログインなしとの差分を記載&lt;/p&gt;&lt;p&gt;・カテゴリーが追加でき、タブの形状で表示される。デフォルトではAllが選択されている。&lt;/p&gt;&lt;p&gt;・タブ右側にあるプラスボタンでカテゴリを追加できる。&lt;/p&gt;&lt;p&gt;・カテゴリが増えタブ要素の幅に収まらない場合は左右のボタン（この資料では三角じるし）でスクロールできる。&lt;/p&gt;&lt;p&gt;・インポートはカテゴリごとに行われる。&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;・Allカテゴリの場合はインポートできない仕様とし、インポート用のテキストエリア、ボタンは表示されない。&lt;/span&gt;&lt;/p&gt;&lt;p&gt;（その他 Phase2）&lt;/p&gt;&lt;p&gt;・CSVエクスポート、インポート&lt;/p&gt;&lt;p&gt;・ラベル、タグを付与し検索する&lt;/p&gt;" vertex="1">
          <mxGeometry height="520" width="240" x="1880" y="40" as="geometry" />
        </mxCell>

        <mxCell id="Up0seM3ziYC3CZbjDRAz-351" parent="Up0seM3ziYC3CZbjDRAz-349" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Material_Core-2642/content-copy-1093.svg" value="" vertex="1">

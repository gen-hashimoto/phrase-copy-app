        <mxCell id="b8LgThF_TDmVwhqBizb6-64" parent="b8LgThF_TDmVwhqBizb6-65" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Material_Core-2642/delete-1104.svg;container=0;" value="" vertex="1">

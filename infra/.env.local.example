# MySQL
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=phrase_app
MYSQL_USER=phrase_app_user
MYSQL_PASSWORD=local-password

# Backend
DATABASE_URL=mysql+pymysql://phrase_app_user:local-password@db:3306/phrase_app
JWT_SECRET=local-dev-secret
AUTH_COOKIE_SECURE=false
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025

# AWS
AWS_REGION=ap-northeast-1
SES_FROM_EMAIL=noreply@phrases.chiisai-tools.com
APP_ORIGIN=http://localhost:3000
IS_DEVELOPMENT=true

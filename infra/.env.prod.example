# Caddy
APP_DOMAIN=example.com
CADDY_EMAIL=admin@example.com

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-long-random-root-password
MYSQL_DATABASE=phrase_app
MYSQL_USER=phrase_app_user
MYSQL_PASSWORD=replace-with-long-random-app-password

# Backend
DATABASE_URL=mysql+pymysql://phrase_app_user:replace-with-long-random-app-password@db:3306/phrase_app
JWT_SECRET=replace-with-long-random-jwt-secret
AUTH_COOKIE_SECURE=true
EMAIL_BACKEND=ses

# AWS
AWS_RESION=ap-northeast-1
SES_FROM_EMAIL=noreply@phrases.chiisai-tools.com
APP_ORIGIN=https://your-app-domain.com
IS_DEVELOPMENT=true

# Caddy
APP_DOMAIN=app.example.com
ROOT_DOMAIN=example.com
CADDY_EMAIL=admin@example.com

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-long-random-root-password
MYSQL_DATABASE=phrase_app
MYSQL_USER=phrase_app_user
MYSQL_PASSWORD=replace-with-long-random-app-password

# Backend
DATABASE_URL=mysql+pymysql://phrase_app_user:replace-with-long-random-app-password@db:3306/phrase_app
JWT_SECRET=replace-with-long-random-jwt-secret
AUTH_COOKIE_SECURE=true
MAIL_PROVIDER=ses
SMTP_HOST=mailpit
SMTP_PORT=1025
FROM_EMAIL=noreply@phrases.chiisai-tools.com

# AWS
AWS_REGION=ap-northeast-1
APP_ORIGIN=https://your-app-domain.com
IS_DEVELOPMENT=false

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Search Console (optional — HTML tag verification)
GSC_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ECR
ECR_REGISTRY=ACCOUNT_ID.dkr.ecr.ap-northeast-1.amazonaws.com
IMAGE_TAG=latest

# Resend
RESEND_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

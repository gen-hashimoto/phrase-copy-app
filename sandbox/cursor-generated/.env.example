# リポジトリ直下（sandbox/cursor-generated/）に .env をコピーして編集してください。
# cp .env.example .env

# MySQL（docker compose の db サービス）
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=phrase_sample
MYSQL_USER=phrase_user
MYSQL_PASSWORD=phrase_secret

# ホストから MySQL に接続する場合は compose のポート転送を参照（既定 3307→コンテナ3306）

# FastAPI / SQLAlchemy（backend コンテナからはホスト名 db）
DATABASE_URL=mysql+pymysql://phrase_user:phrase_secret@db:3306/phrase_sample

# CORS（カンマ区切り。ローカルフロントの例）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
